    {
      "type": "timeseries",
      "title": "Errors / s",
      "description": "5xx are bugs; 4xx are refused requests (quota, conflicts, bad input). 401s are left out.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
