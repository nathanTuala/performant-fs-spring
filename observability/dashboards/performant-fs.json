          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{uri=~\"/api/.*\", status=~\"5..\"}[$__rate_interval]))",
