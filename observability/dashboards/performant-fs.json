          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "description": "",
      "id": 10,
      "datasource": {
        "type": "prometheus",
