{
  "uid": "performant-fs",
  "title": "Performant FS",
  "tags": [
    "performant-fs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
